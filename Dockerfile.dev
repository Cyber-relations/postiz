FROM node:22.23.2-trixie-slim@sha256:7b8a0c89c54499bee567618f96578e1a12a800f062fbdbfd1fb6a443fa6f6284 AS build
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION}

# Native build dependencies never cross into the runtime stage. Refresh the
# immutable base's OS packages before compiling so the final copy does not
# inherit stale toolchain packages from this stage.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      g++ \
      make \
      python3-pip \
 && rm -rf /var/lib/apt/lists/*

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1

WORKDIR /app
COPY . /app
RUN pnpm install --frozen-lockfile
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

FROM node:22.23.2-trixie-slim@sha256:7b8a0c89c54499bee567618f96578e1a12a800f062fbdbfd1fb6a443fa6f6284 AS runtime
ARG NEXT_PUBLIC_VERSION
ARG TOYBACO_SOURCE_COMMIT
ARG TOYBACO_SOURCE_TREE
ENV NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION}
LABEL org.opencontainers.image.source="https://github.com/Cyber-relations/postiz" \
      org.opencontainers.image.revision="${TOYBACO_SOURCE_COMMIT}" \
      jp.toybaco.source.tree="${TOYBACO_SOURCE_TREE}"

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash \
      nginx \
 && rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www /uploads /var/lib/nginx /var/log/nginx \
 && touch /var/log/nginx/access.log /var/log/nginx/error.log \
 && chown -R www:www /www /uploads /var/lib/nginx /var/log/nginx

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2@7.0.4

WORKDIR /app
COPY --from=build --chown=www:www /app /app
COPY --from=build /app/var/docker/nginx.conf /etc/nginx/nginx.conf

USER www
CMD ["sh", "-c", "nginx -g 'pid /tmp/nginx.pid;' && exec pnpm run pm2"]
