FROM node:22.23.2-alpine3.24@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION}

# Native build dependencies and pnpm never cross into the runtime stage.
RUN apk update \
 && apk upgrade --no-cache \
 && apk add --no-cache \
      g++ \
      make \
      python3

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1

WORKDIR /app
COPY . /app
RUN pnpm install --frozen-lockfile
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

FROM node:22.23.2-alpine3.24@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runtime
ARG NEXT_PUBLIC_VERSION
ARG TOYBACO_SOURCE_COMMIT
ARG TOYBACO_SOURCE_TREE
ENV NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION} \
    NODE_ENV=production
LABEL org.opencontainers.image.source="https://github.com/Cyber-relations/postiz" \
      org.opencontainers.image.revision="${TOYBACO_SOURCE_COMMIT}" \
      jp.toybaco.source.tree="${TOYBACO_SOURCE_TREE}"

RUN apk update \
 && apk upgrade --no-cache \
 && apk add --no-cache \
      nginx \
      tini

RUN addgroup -S -g 10001 www \
 && adduser -S -D -H -u 10001 -G www -h /www www \
 && mkdir -p /www /uploads /var/lib/nginx /var/log/nginx \
 && touch /var/log/nginx/access.log /var/log/nginx/error.log \
 && chown -R www:www /www /uploads /var/lib/nginx /var/log/nginx

WORKDIR /app
COPY --from=build --chown=www:www /app /app
COPY --from=build /app/var/docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chmod=0555 /app/var/docker/toybaco-entrypoint.sh /usr/local/bin/toybaco-entrypoint

USER www
STOPSIGNAL SIGTERM
ENTRYPOINT ["/sbin/tini", "-g", "--"]
CMD ["/usr/local/bin/toybaco-entrypoint"]
