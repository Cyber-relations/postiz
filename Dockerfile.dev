FROM node:22.23.4-trixie-slim@sha256:8eb619e402eaede1748a3c8173bffab391592812e85136452f781741c7242ddf AS build
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION}

# Native build dependencies and pnpm never cross into the runtime stage.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      g++ \
      make \
      python3 \
 && rm -rf /var/lib/apt/lists/*

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1

WORKDIR /app
COPY . /app
RUN node var/docker/toybaco-verify-rds-public-ca.cjs --install /app \
 && node var/docker/toybaco-verify-rds-public-ca.cjs --install-system-trust /app
RUN pnpm install --frozen-lockfile \
 && node var/docker/toybaco-fix-next-shell-quote.cjs --apply /app \
 && node var/docker/toybaco-verify-next-shell-quote.cjs /app \
 && node var/docker/toybaco-verify-ssrf-origin.cjs /app
RUN node var/docker/toybaco-verify-local-fonts.cjs /app
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build
RUN node var/docker/toybaco-verify-local-fonts.cjs --built /app

# Reconcile the hoisted workspace against production dependencies after building.
# Keep generated Prisma/native files; never reinstall or run lifecycle scripts at startup.
FROM build AS production
RUN node var/docker/toybaco-verify-rds-public-ca.cjs /app
RUN node var/docker/toybaco-verify-rds-public-ca.cjs --verify-system-trust /app
RUN node var/docker/toybaco-verify-local-fonts.cjs --built /app
RUN CI=true pnpm install --prod --frozen-lockfile --offline --ignore-scripts \
 && node var/docker/toybaco-fix-next-shell-quote.cjs --apply /app \
 && node var/docker/toybaco-verify-next-shell-quote.cjs /app \
 && node var/docker/toybaco-verify-ssrf-origin.cjs /app
RUN test ! -e node_modules/vitest \
 && test ! -e node_modules/ts-jest \
 && test ! -e node_modules/happy-dom \
 && test -f node_modules/prisma/build/index.js \
 && test -f node_modules/.prisma/client/index.js

# Rebuild Debian zlib1g from checksum-pinned source with the reviewed CVE-2026-85091
# source backport (same ABI and architecture) and prove the fix with the native
# reproducer. Only the rebuilt .deb and its build stamp leave this stage.
FROM node:22.23.4-trixie-slim@sha256:8eb619e402eaede1748a3c8173bffab391592812e85136452f781741c7242ddf AS zlib-backport
COPY var/docker/os-backport/zlib /toybaco/os-backport/zlib
RUN bash /toybaco/os-backport/zlib/build-zlib1g-backport.sh /toybaco/os-backport/zlib /toybaco/os-backport/out

# Rebuild Debian glibc (libc6, libc-bin) from checksum-pinned source with the
# official 2.41 stable-branch backports for CVE-2026-5435 and CVE-2026-19499 (same
# ABI and architecture). Only the rebuilt .debs and the build stamp leave this stage.
FROM node:22.23.4-trixie-slim@sha256:8eb619e402eaede1748a3c8173bffab391592812e85136452f781741c7242ddf AS glibc-backport
COPY var/docker/os-backport/glibc /toybaco/os-backport/glibc
RUN bash /toybaco/os-backport/glibc/build-glibc-backport.sh /toybaco/os-backport/glibc /toybaco/os-backport/out

# Build Node.js 22.23.4 from the exact release source (SHASUMS256.txt signature and
# SHA-256 pins checked) with --shared-zlib against the reviewed zlib1g source backport,
# so the runtime binary links the system libz.so.1 and carries no gz* of its own. The
# read-only glibc-backport mount orders the two all-CPU native builds (glibc, then
# Node); make -j is bounded by memory and the cgroup quota inside the script. Only the
# node binary, its LICENSE and the build stamp leave this stage.
FROM node:22.23.4-trixie-slim@sha256:8eb619e402eaede1748a3c8173bffab391592812e85136452f781741c7242ddf AS node-source
COPY var/docker/os-backport/node /toybaco/os-backport/node
ARG TOYBACO_NODE_BUILD_DEADLINE_EPOCH
RUN --mount=type=bind,from=zlib-backport,source=/toybaco/os-backport/out,target=/toybaco/os-backport/zlib-out \
    --mount=type=bind,from=glibc-backport,source=/toybaco/os-backport/out,target=/toybaco/os-backport/glibc-out \
    --mount=type=bind,source=var/docker/os-backport/zlib,target=/toybaco/os-backport/zlib-src \
    bash /toybaco/os-backport/node/build-node-shared-zlib.sh /toybaco/os-backport/node /toybaco/os-backport/zlib-out /toybaco/os-backport/glibc-out /toybaco/os-backport/zlib-src /toybaco/os-backport/node-out

FROM nginx:1.30.6@sha256:eb1c896deef834f4e056829fd6dadac8305501f16cc71ba65fb252c8d0aa168e AS runtime
ARG NEXT_PUBLIC_VERSION
ARG TOYBACO_SOURCE_COMMIT
ARG TOYBACO_SOURCE_TREE
ENV NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION} \
    NODE_ENV=production \
    NODE_VERSION=22.23.4 \
    HOME=/www
LABEL org.opencontainers.image.source="https://github.com/Cyber-relations/postiz" \
      org.opencontainers.image.revision="${TOYBACO_SOURCE_COMMIT}" \
      jp.toybaco.source.tree="${TOYBACO_SOURCE_TREE}"

USER root

# These optional modules are not loaded by the application Nginx configuration.
# Keep fonts and Sharp bundled codecs; remove the unused OS GD/HEIF dependency group.
# Node and Nginx use their own HTTP transports; keep curl libraries out of runtime.
# Keep bundled Sharp codecs and fonts; prune unused OS TLS, LDAP and image libraries.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
 && DEBIAN_FRONTEND=noninteractive apt-get purge -y --no-auto-remove \
      nginx-module-image-filter nginx-module-njs nginx-module-xslt libxml2 libxslt1.1 libgd3 libheif1 libheif-plugin-dav1d libheif-plugin-libde265 curl libcurl4t64 libnghttp2-14 libtiff6 librtmp1 libgnutls30t64 libkrb5-3 libgssapi-krb5-2 libk5crypto3 libkrb5support0 libsasl2-2 libsasl2-modules-db libldap2 libexpat1 libfontconfig1 libfreetype6 libpng16-16t64 \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      tini \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 www \
 && useradd --system --uid 10001 --gid www --home-dir /www --no-create-home --shell /usr/sbin/nologin www \
 && mkdir -p /www /uploads /var/cache/nginx \
 && chown -R www:www /www /uploads /var/cache/nginx

WORKDIR /app
COPY --from=node-source /toybaco/os-backport/node-out/node /usr/local/bin/node
COPY --from=node-source /toybaco/os-backport/node-out/LICENSE /usr/local/share/licenses/node/LICENSE
COPY --from=node-source /toybaco/os-backport/node-out/build-stamp.json /usr/local/share/toybaco/node/build-stamp.json
COPY --from=production --chown=www:www /app /app
COPY --from=build /app/var/docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chmod=0555 /app/var/docker/toybaco-entrypoint.sh /usr/local/bin/toybaco-entrypoint
RUN node /app/var/docker/toybaco-verify-rds-public-ca.cjs --install-system-trust /app
# Replace the base zlib1g and glibc with the reviewed source backports.
RUN --mount=type=bind,from=zlib-backport,source=/toybaco/os-backport/out,target=/tmp/toybaco-zlib-backport \
    node /app/var/docker/toybaco-verify-os-backport.cjs --install /tmp/toybaco-zlib-backport /app/var/docker/os-backport/postiz-os-backport.json
RUN --mount=type=bind,from=glibc-backport,source=/toybaco/os-backport/out,target=/tmp/toybaco-glibc-backport \
    node /app/var/docker/toybaco-verify-os-backport.cjs --install /tmp/toybaco-glibc-backport /app/var/docker/os-backport/postiz-os-backport.json

USER www
RUN node /app/var/docker/toybaco-verify-os-runtime.cjs /app
RUN node /app/var/docker/toybaco-verify-os-backport.cjs verify /app/var/docker/os-backport/postiz-os-backport.json
RUN node /app/var/docker/toybaco-verify-node-shared-zlib.cjs verify /usr/local/share/toybaco/node/build-stamp.json
RUN node /app/var/docker/toybaco-verify-rds-public-ca.cjs /app
RUN node /app/var/docker/toybaco-verify-rds-public-ca.cjs --verify-system-trust /app
RUN node /app/var/docker/toybaco-verify-local-fonts.cjs --built /app
RUN node /app/var/docker/toybaco-verify-next-shell-quote.cjs /app \
 && node /app/var/docker/toybaco-verify-ssrf-origin.cjs /app
RUN node /app/var/docker/toybaco-verify-node-shared-zlib.cjs native-modules /app
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["/usr/local/bin/toybaco-entrypoint"]
