FROM node:22.23.2-trixie-slim@sha256:7b8a0c89c54499bee567618f96578e1a12a800f062fbdbfd1fb6a443fa6f6284 AS build
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION}

# Native build dependencies and pnpm never cross into the runtime stage.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      g++ \
      make \
      python3 \
 && rm -rf /var/lib/apt/lists/*

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1

WORKDIR /app
COPY . /app
RUN pnpm install --frozen-lockfile
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# Reconcile the hoisted workspace against production dependencies after building.
# Keep generated Prisma/native files; never reinstall or run lifecycle scripts at startup.
FROM build AS production
RUN CI=true pnpm install --prod --frozen-lockfile --offline --ignore-scripts
RUN test ! -e node_modules/vitest \
 && test ! -e node_modules/ts-jest \
 && test ! -e node_modules/happy-dom \
 && test -f node_modules/prisma/build/index.js \
 && test -f node_modules/.prisma/client/index.js

FROM nginx:1.30.4@sha256:09cc2702709e6388d979d8030e3ab4eb1ceb699b2dced26d7543e872a822e823 AS runtime
ARG NEXT_PUBLIC_VERSION
ARG TOYBACO_SOURCE_COMMIT
ARG TOYBACO_SOURCE_TREE
ENV NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION} \
    NODE_ENV=production \
    NODE_VERSION=22.23.2 \
    HOME=/www
LABEL org.opencontainers.image.source="https://github.com/Cyber-relations/postiz" \
      org.opencontainers.image.revision="${TOYBACO_SOURCE_COMMIT}" \
      jp.toybaco.source.tree="${TOYBACO_SOURCE_TREE}"

USER root

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      tini \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 www \
 && useradd --system --uid 10001 --gid www --home-dir /www --no-create-home --shell /usr/sbin/nologin www \
 && mkdir -p /www /uploads /var/cache/nginx \
 && chown -R www:www /www /uploads /var/cache/nginx

WORKDIR /app
COPY --from=build /usr/local/bin/node /usr/local/bin/node
COPY --from=build /usr/local/LICENSE /usr/local/share/licenses/node/LICENSE
COPY --from=production --chown=www:www /app /app
COPY --from=build /app/var/docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chmod=0555 /app/var/docker/toybaco-entrypoint.sh /usr/local/bin/toybaco-entrypoint

USER www
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["/usr/local/bin/toybaco-entrypoint"]
